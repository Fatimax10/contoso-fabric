# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# Authentication comes from GITHUB_TOKEN, never from this file.

# Required. The organisation must already exist.
organization = "contoso-fabric-demo"

repository_name       = "contoso-fabric"
repository_visibility = "private"

# Must match the job names in .github/workflows/ci.yml exactly.
required_status_checks = [
  "dotnet / build & test",
  "node / build & typecheck",
  "python / lint & test",
]

# Without this, Beat 4 fails silently. See ../../README.md for how to get the ID.
# copilot_bypass_actor_id = 123456

# At least one reviewer, or the Beat 9 approval gate never appears.
production_reviewers = []

production_wait_timer_minutes = 0
